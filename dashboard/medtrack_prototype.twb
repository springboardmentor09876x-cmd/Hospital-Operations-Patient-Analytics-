    <worksheet name='WS17_Recovery_Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Recovery Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (hospital_final_dataset)' name='federated.1mhsjww1rnkci516t94hw1dfejwc' />
          </datasources>
          <datasource-dependencies datasource='federated.1mhsjww1rnkci516t94hw1dfejwc'>
            <column datatype='integer' name='[AGE]' role='measure' type='quantitative' />
            <column caption='Age Group' datatype='string' name='[Calculation_2465406441328642]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [AGE] &lt; 18 THEN &quot;0-17&quot;&#13;&#10;&#13;&#10;ELSEIF [AGE] &lt;= 40 THEN &quot;18-40&quot;&#13;&#10;&#13;&#10;ELSEIF [AGE] &lt;= 60 THEN &quot;41-60&quot;&#13;&#10;&#13;&#10;ELSEIF [AGE] &lt;= 75 THEN &quot;61-75&quot;&#13;&#10;&#13;&#10;ELSE &quot;75+&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Recovery Rate' datatype='real' name='[Calculation_2465406688755730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [OUTCOME] = &quot;DISCHARGE&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([MRD No.])&#13;&#10;*100' />
            </column>
            <column caption='STR(ROUND([Recovery Rate],1)) + &quot;%&quot;' datatype='string' name='[Calculation_2465406689382420]' role='measure' type='nominal' user:unnamed='WS17_Recovery_Rate'>
              <calculation class='tableau' formula='STR(ROUND([Calculation_2465406688755730],1)) + &quot;%&quot;' />
            </column>
            <column datatype='date' name='[D.O.A]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Gender' datatype='string' name='[GENDER]' role='dimension' type='nominal' />
            <column caption='Hospital Name' datatype='string' name='[Hospital_Name]' role='dimension' type='nominal' />
            <column caption='Hospital Type' datatype='string' name='[Hospital_Type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[MRD No.]' role='measure' type='quantitative' />
            <column caption='Outcome' datatype='string' name='[OUTCOME]' role='dimension' type='nominal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[D.O.A]' derivation='Month' name='[mn:D.O.A:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2465406441328642]' derivation='None' name='[none:Calculation_2465406441328642:nk]' pivot='key' type='nominal' />
