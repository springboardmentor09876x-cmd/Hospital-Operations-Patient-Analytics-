      <column caption='Alcohol' datatype='integer' name='[ALCOHOL]' role='measure' type='quantitative' />
      <column caption='Anaemia' datatype='integer' name='[ANAEMIA]' role='measure' type='quantitative' />
      <column caption='Atypical Chest Pain' datatype='integer' name='[ATYPICAL CHEST PAIN]' role='measure' type='quantitative' />
      <column caption='Avg Length of Stay' datatype='real' name='[Avg_Length_of_Stay]' role='measure' type='quantitative' />
      <column caption='Bed Utilization' datatype='real' name='[Bed_Utilization]' role='measure' type='quantitative' />
      <column caption='Beds Available' datatype='integer' name='[Beds_Available]' role='measure' type='quantitative' />
      <column caption='Beds Occupied' datatype='integer' name='[Beds_Occupied]' role='measure' type='quantitative' />
      <column aggregation='CountD' datatype='string' name='[CAD]' role='dimension' type='nominal' />
      <column caption='Cardiogenic Shock' datatype='integer' name='[CARDIOGENIC SHOCK]' role='measure' type='quantitative' />
      <column caption='Chest Infection' datatype='integer' name='[CHEST INFECTION]' role='measure' type='quantitative' />
      <column aggregation='CountD' datatype='string' name='[CKD]' role='dimension' type='nominal' />
      <column caption='Congenital' datatype='integer' name='[CONGENITAL]' role='measure' type='quantitative' />
      <column caption='Creatinine' datatype='real' name='[CREATININE]' role='measure' type='quantitative' />
      <column caption='Cva Bleed' datatype='integer' name='[CVA BLEED]' role='measure' type='quantitative' />
      <column caption='Cva Infract' datatype='integer' name='[CVA INFRACT]' role='measure' type='quantitative' />
      <column caption='Admission Month' datatype='string' name='[Calculation_2465406440771584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[D.O.A])' />
      </column>
      <column caption='Admission Month-Year' datatype='datetime' name='[Calculation_2465406441029633]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[D.O.A])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_2465406441328642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [AGE] &lt; 18 THEN &quot;0-17&quot;&#13;&#10;&#13;&#10;ELSEIF [AGE] &lt;= 40 THEN &quot;18-40&quot;&#13;&#10;&#13;&#10;ELSEIF [AGE] &lt;= 60 THEN &quot;41-60&quot;&#13;&#10;&#13;&#10;ELSEIF [AGE] &lt;= 75 THEN &quot;61-75&quot;&#13;&#10;&#13;&#10;ELSE &quot;75+&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='LOS Category' datatype='string' name='[Calculation_2465406441562115]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DURATION OF STAY] &lt;= 3 THEN &quot;Short Stay&quot;&#13;&#10;&#13;&#10;ELSEIF [DURATION OF STAY] &lt;= 7 THEN &quot;Medium Stay&quot;&#13;&#10;&#13;&#10;ELSEIF [DURATION OF STAY] &lt;= 14 THEN &quot;Long Stay&quot;&#13;&#10;&#13;&#10;ELSE &quot;Extended Stay&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Readmission Label' datatype='string' name='[Calculation_2465406442139652]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Readmission]=1&#13;&#10;&#13;&#10;THEN &quot;Readmitted&quot;&#13;&#10;&#13;&#10;ELSE &quot;Not Readmitted&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Occupancy %' datatype='string' name='[Calculation_2465406442610693]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([Occupancy_Rate]),1)) + &quot;%&quot;' />
      </column>
      <column caption='Bed Utilization %' datatype='string' name='[Calculation_2465406443044870]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([Bed_Utilization]),1)) + &quot;%&quot;' />
      </column>
      <column caption='Average Stay' datatype='real' name='[Calculation_2465406443933703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([DURATION OF STAY])' />
      </column>
      <column caption='ICU Utilization KPI' datatype='string' name='[Calculation_2465406470459400]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([ICU_Utilization]),1)) + &quot;%&quot;' />
      </column>
      <column caption='Weekend Admission' datatype='string' name='[Calculation_2465406681919504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [D.O.A]) = 1&#13;&#10;OR DATEPART(&apos;weekday&apos;, [D.O.A]) = 7&#13;&#10;THEN &quot;Weekend&quot;&#13;&#10;ELSE &quot;Weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='High Risk Patient' datatype='string' name='[Calculation_2465406686076945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SHOCK] = 1&#13;&#10;OR [STEMI] = &quot;Yes&quot;&#13;&#10;OR [CKD] = &quot;Yes&quot;&#13;&#10;OR [HFREF] = &quot;Yes&quot;&#13;&#10;OR [PULMONARY EMBOLISM] = 1&#13;&#10;OR [SEVERE ANAEMIA] = 1&#13;&#10;THEN &quot;High Risk&quot;&#13;&#10;&#13;&#10;ELSE &quot;Normal&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Recovery Rate' datatype='real' name='[Calculation_2465406688755730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [OUTCOME] = &quot;DISCHARGE&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([MRD No.])&#13;&#10;*100' />
      </column>
      <column caption='Overloaded Department' datatype='integer' name='[Calculation_2465406712037399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Patient_per_Nurse] &gt; 6 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Total Beds KPI' datatype='integer' name='[Calculation_2465406725308444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM({ FIXED [Hospital_Name] : MAX([Total_Beds]) }) }' />
      </column>
      <column caption='Total ICU Beds KPI' datatype='integer' name='[Calculation_2465406725845021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM({ FIXED [Hospital_Name] : MAX([ICU_Beds]) }) }' />
      </column>
      <column caption='Total Nurses KPI' datatype='integer' name='[Calculation_2465406726000670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM({ FIXED [Hospital_Name] : MAX([Nurses]) }) }' />
      </column>
      <column caption='Total Staff KPI' datatype='integer' name='[Calculation_2465406726205471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM({ FIXED [Hospital_Name] : MAX([Staff_Count]) }) }' />
      </column>
      <column caption='Occupied Beds ' datatype='real' name='[Calculation_2465406736019490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Hospital_Name] :&#13;&#10;    ROUND(MAX([Beds_Occupied]) * MAX([Total_Beds]) / 100, 0)&#13;&#10;}' />
      </column>
      <column caption='Available Beds ' datatype='real' name='[Calculation_2465406736130083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Hospital_Name] :&#13;&#10;    MAX([Total_Beds]) -&#13;&#10;    ROUND(MAX([Beds_Occupied]) * MAX([Total_Beds]) / 100, 0)&#13;&#10;}' />
      </column>
